[
  {
    "id": "alt-01",
    "description": "Alternatives for academic words in typical student sentence",
    "sentence": "This demonstrates the significant role of communication in how individuals understand themselves.",
    "tokenTests": [
      {
        "token": "demonstrates",
        "expectedEditable": true,
        "expectedProtected": false,
        "expectedMinAlternatives": 5,
        "expectedTopAlternatives": ["shows", "suggests", "points to", "makes clear", "helps show", "reveals", "indicates", "supports the idea", "helps explain"],
        "notes": "Should prefer 'shows' as top alternative"
      },
      {
        "token": "significant",
        "expectedEditable": true,
        "expectedProtected": false,
        "expectedMinAlternatives": 5,
        "expectedTopAlternatives": ["important", "clear", "major", "meaningful", "big", "noticeable", "real", "strong"],
        "notes": "Should prefer 'important' as top alternative"
      },
      {
        "token": "individuals",
        "expectedEditable": true,
        "expectedProtected": false,
        "expectedMinAlternatives": 5,
        "expectedTopAlternatives": ["people", "students", "others", "someone", "a person"],
        "notes": "Should prefer 'people' as top alternative"
      },
      {
        "token": "communication",
        "expectedEditable": true,
        "expectedProtected": false,
        "expectedMinAlternatives": 3,
        "expectedTopAlternatives": ["communication", "the way people communicate", "talking", "how people talk"],
        "notes": "May preserve the term if it is correct course term"
      }
    ]
  },
  {
