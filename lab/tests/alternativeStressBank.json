        "expectedProtected": true,
        "expectedMinAlternatives": 0,
        "expectedTopAlternatives": [],
        "notes": "Quoted title must be protected"
      },
      {
        "token": "1955",
        "expectedEditable": false,
        "expectedProtected": true,
        "expectedMinAlternatives": 0,
        "expectedTopAlternatives": [],
        "notes": "Number must be protected"
      },
      {
        "token": "cast",
        "expectedEditable": true,
        "expectedProtected": false,
        "expectedMinAlternatives": 1,
        "expectedTopAlternatives": [],
