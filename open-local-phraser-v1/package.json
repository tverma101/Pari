{
  "name": "open-local-phraser-v2",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "qa:paraphrase": "node scripts/qa-paraphrase.mjs && node scripts/qa-native-ranker.mjs && node scripts/qa-rule-nli.mjs && node scripts/qa-rule-ranker.mjs && node scripts/qa-meaning-audit.mjs && node scripts/qa-protected-units.mjs && node scripts/qa-article-sound.mjs && node scripts/qa-meaning-agreement.mjs && node scripts/qa-meaning-bounds.mjs && node scripts/qa-protected-additions.mjs",
    "qa:approval": "node scripts/qa-paraphrase.mjs",
    "qa:grammar:harper": "node scripts/qa-harper.mjs",
    "qa:native:model": "node scripts/qa-native-model.mjs",
    "qa:native:prompt": "python3 scripts/qa-native-prompt.py",
    "qa:native:ranker": "node scripts/qa-native-ranker.mjs",
    "qa:rule:nli": "node scripts/qa-rule-nli.mjs",
    "qa:rule:ranker": "node scripts/qa-rule-ranker.mjs",
    "qa:meaning-audit": "node scripts/qa-meaning-audit.mjs",
    "qa:meaning-agreement": "node scripts/qa-meaning-agreement.mjs",
    "qa:meaning:bounds": "node scripts/qa-meaning-bounds.mjs",
    "qa:protected:units": "node scripts/qa-protected-units.mjs",
    "qa:protected:additions": "node scripts/qa-protected-additions.mjs",
    "qa:article:sound": "node scripts/qa-article-sound.mjs",
    "qa:agent:styles": "node scripts/qa-agent-style-backend.mjs",
    "benchmark:local": "node scripts/benchmark-paraphrase.mjs",
    "benchmark:quality": "node scripts/benchmark-paraphrase.mjs",
    "benchmark:v2:validate": "node benchmarks/paraphrase-v2/validate.mjs",
    "benchmark:v2:score": "node benchmarks/paraphrase-v2/score.mjs",
    "benchmark:v2:report": "node benchmarks/paraphrase-v2/report.mjs",
    "benchmark:v2:meaning-audit": "node benchmarks/paraphrase-v2/meaning-audit.mjs",
    "benchmark:v2:meaning-agreement": "node benchmarks/paraphrase-v2/meaning-audit-agreement.mjs",
    "benchmark:v2:local": "node benchmarks/paraphrase-v2/run-local.mjs",
    "benchmark:v2:reference": "node benchmarks/paraphrase-v2/run-reference.mjs",
    "models:download": "node scripts/download-models.mjs",
    "models:download:native": "node scripts/download-models.mjs --native-only --install-native",
    "models:install": "node scripts/install-native-model.mjs",
    "models:check": "node scripts/check-models.mjs",
    "models:check:files": "node scripts/check-models.mjs --files-only",
    "research:grammar:download": "node scripts/download-grammar-resources.mjs",
    "research:grammar:check": "node scripts/check-grammar-resources.mjs",
    "qa:grammar:ewt": "node scripts/qa-ewt-grammar.mjs",
    "qa:learned:judge": "node scripts/qa-learned-judge.mjs",
    "build:lexicon": "node scripts/build-lexicon.mjs && npm run models:check:files && tsc -p tsconfig.json && vite build",
    "build": "npm run build:lexicon && npm run models:check:files && tsc -p tsconfig.json && vite build",
    "build:desktop": "bash build_dmg.sh",
    "qa:installed": "./script/build_and_run.sh --headless",
    "qa:installed:connected": "./script/build_and_run.sh --headless-connected",
    "qa:installed:freellm": "./script/build_and_run.sh --headless-freellm",
    "qa:installed:custom": "node scripts/qa-installed-custom-mode.mjs",
    "qa:installed:missing-model": "./script/build_and_run.sh --headless-missing-model",
    "backend:styles": "./script/build_and_run.sh --agent-style-backend",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "clsx": "2.1.1",
    "harper.js": "2.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "moby": "^1.1.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "wordnet": "^2.0.0"
  }
}
