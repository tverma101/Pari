{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pari.local/schemas/english-core-result-schema.json",
  "title": "Pari English Core model result",
  "type": "object",
  "required": ["runId", "model", "outputs"],
  "properties": {
    "runId": {"type": "string"},
    "timestamp": {"type": "string"},
    "taskFile": {"type": "string"},
    "taskFileSha256": {"type": "string"},
    "model": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "repoOrName": {"type": "string"},
        "revision": {"type": "string"},
        "artifactSha256": {"type": "string"},
        "quantization": {"type": "string"},
        "checkpointType": {"type": "string", "enum": ["base", "instruct", "chat", "specialized", "unknown"]},
        "runtime": {"type": "string"},
        "runtimeVersion": {"type": "string"},
        "chatTemplate": {"type": "string"}
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "machine": {"type": "string"},
        "chip": {"type": "string"},
        "memoryGB": {"type": "number"},
        "os": {"type": "string"},
        "python": {"type": "string"}
      }
    },
    "decoding": {
      "type": "object",
      "properties": {
        "temperature": {"type": "number"},
        "topP": {"type": "number"},
        "topK": {"type": "integer"},
        "maxNewTokens": {"type": "integer"},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "output"],
        "properties": {
          "id": {"type": "string"},
          "output": {"type": "string"},
          "latencySeconds": {"type": "number"},
          "probabilities": {
            "type": "object",
            "description": "Optional diagnostic probabilities/logits. Text-output scoring remains the cross-runtime primary prompted measure.",
            "additionalProperties": {"type": "number"}
          },
          "metricScores": {
            "description": "For generative-expression cases only. Values are normalized observations in [0,1] under the recorded protocol, not automatically assumed to be higher-is-better utilities. Directionality is defined by english-core-generative-metric-contract.json and converted by score-english-core.mjs.",
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "metricProvenance": {
            "description": "Structured provenance for generative metricScores. The protocol field must define the scoring/normalization procedure. A free-form source name alone is insufficient for official English Core scoring.",
            "type": "object",
            "required": ["kind", "name", "protocol", "candidateSelfGrade"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "deterministic",
                  "human_reference",
                  "official_benchmark_metric",
                  "specialist_model",
                  "blinded_human",
                  "general_llm_diagnostic"
                ]
              },
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string"},
              "reference": {"type": "string"},
              "protocol": {
                "type": "string",
                "minLength": 1,
                "description": "Predeclared procedure that maps raw evaluator judgments/measurements into the normalized 0..1 observations in metricScores."
              },
              "validatedAgainstHumans": {"type": "boolean"},
              "validationReference": {"type": "string"},
              "candidateSelfGrade": {"const": false},
              "notes": {"type": "string"}
            }
          },
          "metricSource": {
            "description": "Legacy informational field only. It no longer qualifies generative scores for the official composite without metricProvenance.",
            "type": "string"
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "benchmarkRevision": {"type": "string"},
        "scorerRevision": {"type": "string"},
        "rawOutputSha256": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
